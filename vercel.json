{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,config.php,index.php,assets/**}"
    }
  },
  "routes": [
    {"src": "/assets/(.*\\.(?:css|js|svg))", "dest": "/assets/$1"},
    {"src": "/(?:index\\.php)?", "dest": "/api/index.php"},
    {"src": "/.*", "status": 404}
  ]
}
